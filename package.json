{
  "name": "quiniela",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generar-sw.js prod",
    "build:prod": "ng build --configuration production && node scripts/generar-sw.js prod",
    "build:dev": "ng build --configuration development && node scripts/generar-sw.js dev",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pruebas": "node scripts/run-pruebas.js",
    "pruebas:limpiar": "node scripts/seed-dev.js limpiar"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.26",
    "@tabler/icons-webfont": "^3.31.0",
    "@types/qrcode": "^1.5.6",
    "firebase": "^11.10.0",
    "firebase-admin": "^14.3.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
