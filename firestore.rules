rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /* ---------- Quiniela de pronósticos ---------- */

    match /partidos/{id} {
      allow read: if request.auth != null;
      allow create: if isAdmin() && request.resource.data.closesAt > request.time;
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      // Solo tú y el administrador ven tu documento (contiene el correo).
      allow read: if isAdmin() || request.auth.uid == uid;

      // Al registrarse: saldo en cero y cuenta sin validar, siempre.
      allow create: if request.auth.uid == uid
        && request.resource.data.puntos == 0
        && request.resource.data.validada == false;

      // Puntos, validación y contadores solo se tocan desde el servidor.
      allow update, delete: if isAdmin();
    }

    match /pronosticos/{id} {
      allow read: if request.auth != null;
      // Los crea la Cloud Function crearPronostico, que valida saldo y hora.
      allow write: if false;
    }

    match /ledger/{id} {
      allow read: if isAdmin() || resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /bolsas/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sistema/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ranking/{uid} {
      // Público entre usuarios: alias y estadísticas, sin correos.
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
    }

    /* ---------- Modo supervivencia ---------- */

    match /competiciones/{compId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /jornadas/{jornadaId} {
        allow read: if request.auth != null;
        // Admin global, o gestor de esta liga. El get() lee el array
        // gestores del documento padre de forma explícita.
        allow write: if request.auth != null && (
          isAdmin() ||
          (
            'gestores' in get(/databases/$(database)/documents/competiciones/$(compId)).data
            && request.auth.uid in get(/databases/$(database)/documents/competiciones/$(compId)).data.gestores
          )
        );
      }
    }

    match /torneos/{torneoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      // Inscripciones y elecciones: solo desde Cloud Functions.
      match /participantes/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      match /picks/{pickId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      // Cartones de quiniela: lectura para todos, escritura por funciones.
      match /quinielas/{quinielaId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /brackets/{bracketId} {
      // Lectura para cualquiera con sesión; toda escritura pasa por funciones.
      allow read: if request.auth != null;
      allow write: if false;

      match /pronosticos/{pid} {
        // Ves el tuyo siempre. Los de los demás, solo una vez que el
        // pronóstico cerró (estado 'en-curso' o 'finalizado'): así nadie
        // espía cuadros ajenos mientras todavía se puede pronosticar, pero
        // hay transparencia total en cuanto cierra.
        allow read: if request.auth != null && (
          request.auth.uid == pid ||
          get(/databases/$(database)/documents/brackets/$(bracketId)).data.estado in ['en-curso', 'finalizado']
        );
        allow write: if false;
      }
    }

    match /trofeos/{trofeoId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // GRUPOS: las escrituras las hacen las Cloud Functions (Admin SDK).
    // Desde el cliente solo se lee, y solo si perteneces al grupo.
    // Excepción: el super admin puede leer cualquier grupo para gestionarlo.
    match /grupos/{grupoId} {
      function soyMiembro() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/grupos/$(grupoId)/miembros/$(request.auth.uid));
      }
      // Puedes leer el grupo si eres miembro o si eres super admin.
      allow read: if soyMiembro() || isAdmin();
      allow write: if false;

      match /miembros/{uid} {
        allow read: if soyMiembro() || isAdmin();
        allow write: if false;
      }
      match /tabla/{uid} {
        allow read: if soyMiembro() || isAdmin();
        allow write: if false;
      }
    }
  }
}
